<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Bravo Arena</title>
<style>
*{box-sizing:border-box} :root{--gold:#ffcf42;--blue:#42c7ff}body{margin:0;background:#10192e;color:#fff;font-family:system-ui,Arial;min-height:100vh}button{font:inherit;cursor:pointer}
.top{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px max(12px,calc((100vw - 1050px)/2));background:#192b4a;border-bottom:3px solid #354e78}.logo{font-weight:1000;font-size:clamp(20px,4vw,32px);color:var(--gold);text-shadow:0 3px #9a5615}.currency{background:#263d62;border:1px solid #5878a8;border-radius:12px;padding:7px 10px;font-weight:800}
main{max-width:1050px;margin:auto;padding:12px}.screen{display:none}.screen.active{display:block}
.home{min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden;border:3px solid #354e78;border-radius:22px;background:radial-gradient(ellipse at 50% 45%,#4779a5 0,#274568 36%,#172946 72%);padding:20px}
.home:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 15% 25%,#ffffff12 0 3px,transparent 4px),radial-gradient(circle at 80% 70%,#ffffff12 0 4px,transparent 5px);background-size:55px 55px;pointer-events:none}
.subtitle{color:#d3e6ff;margin:5px 0 0}.hero{font-size:clamp(100px,24vw,175px);line-height:1.25;filter:drop-shadow(0 12px 0 #13233c);position:relative;animation:bob 2s ease-in-out infinite}@keyframes bob{50%{transform:translateY(-7px)}}.heroName{font-size:25px;font-weight:1000;color:#fff;text-shadow:0 3px #203654;margin-top:-2px}.tag{font-size:13px;background:#183153;border:1px solid #7195bd;padding:5px 12px;border-radius:99px;color:#d9ecff}
.play{margin:18px 0 10px;width:min(300px,90%);padding:15px;border:0;border-radius:14px;background:linear-gradient(#ffe978,#ffb72b);box-shadow:0 5px #a65c13;color:#472800;font-weight:1000;font-size:22px}.menuButtons{display:flex;gap:9px;flex-wrap:wrap;justify-content:center;position:relative}.menuButtons button,.back{background:#29466f;color:white;border:2px solid #6288b9;border-radius:12px;padding:10px 16px;font-weight:850}.panel{background:#192a47;border:2px solid #3b5681;border-radius:18px;padding:16px}.panel h2{margin:0 0 12px;color:var(--gold)}.back{margin-bottom:12px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:10px}.card{background:#243b60;border:2px solid #46658f;border-radius:14px;padding:14px;text-align:center}.card .emoji{font-size:44px}.card.locked{opacity:.58}.small{color:#c9d9f0;font-size:13px;line-height:1.5}
.hud{display:flex;gap:7px;justify-content:space-between;flex-wrap:wrap;margin-bottom:8px}.pill{background:#192a47;border:1px solid #46658f;border-radius:99px;padding:6px 10px;font-size:13px;font-weight:800}
.arena{position:relative}canvas{display:block;width:100%;max-height:600px;aspect-ratio:1.15/1;background:#8cbd5f;border:4px solid #3b5b37;border-radius:16px;touch-action:none}.overlay{position:absolute;inset:4px;display:grid;place-items:center;background:#081020c9;border-radius:12px;padding:20px;text-align:center}.overlay button{background:var(--gold);border:0;border-radius:12px;padding:12px 20px;font-weight:1000}.hidden{display:none!important}
.mobileControls{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 2px}.pad{display:grid;grid-template-columns:repeat(3,48px);grid-template-rows:repeat(2,43px);gap:5px}.pad button,.fire{border:2px solid #7696c7;background:#29466f;color:#fff;border-radius:12px;font-weight:1000;font-size:19px;touch-action:none;user-select:none;-webkit-user-select:none; -webkit-tap-highlight-color:transparent}.pad .blank{visibility:hidden}.fire{width:90px;height:90px;border-radius:50%;background:#e95045;border-color:#ffaaa0;box-shadow:0 4px #8c2825;font-size:16px}.fire:active,.pad button:active{filter:brightness(1.35);transform:scale(.96)}
.chestBig{font-size:80px;text-align:center}.goldBtn{display:block;margin:12px auto;padding:12px 20px;background:linear-gradient(#ffe978,#ffb72b);border:0;border-radius:12px;font-weight:1000;color:#472800}.reward{text-align:center;font-weight:900;margin-top:12px}.floatReward{animation:popReward 1.2s ease-out both}@keyframes popReward{0%{opacity:0;transform:translateY(18px) scale(.7)}20%{opacity:1;transform:translateY(-5px) scale(1.08)}75%{opacity:1}100%{opacity:0;transform:translateY(-32px) scale(1)}}.fighterIcon{display:inline-block;animation:fighterIdle 1.5s ease-in-out infinite}@keyframes fighterIdle{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-5px) rotate(2deg)}}.coinFly{display:inline-block;animation:coinSpin .7s ease-in-out infinite alternate}@keyframes coinSpin{to{transform:rotateY(180deg) translateY(-3px)}}.upgrade{background:#176d58!important;border-color:#50d5a7!important;margin-top:8px;padding:8px 10px!important}.share{word-break:break-word;background:#10192e;padding:8px;border-radius:8px;font-size:12px}
@media(max-width:650px){main{padding:8px}.home{min-height:73vh;padding:14px}.panel{padding:12px}.mobileControls{padding:10px 0}.pad{grid-template-columns:repeat(3,44px);grid-template-rows:repeat(2,40px)}.fire{width:82px;height:82px}canvas{aspect-ratio:1/1}.top{padding:9px 12px}}
.fighter-title{display:block;margin-top:7px;color:#8fe7ff;font-size:13px;font-weight:1000;text-shadow:0 2px #172946}.prime-tag{display:inline-block;margin-top:7px;padding:5px 9px;border-radius:9px;color:#fff;background:linear-gradient(110deg,#9148ff,#ee4fd6,#ffb62f);font-weight:1000;box-shadow:0 0 14px #d55cff88;animation:primeGlow 1.1s ease-in-out infinite alternate}@keyframes primeGlow{to{filter:brightness(1.3);transform:scale(1.04)}}.trophy-card{display:block;width:max-content;max-width:100%;margin-left:auto;margin-right:auto}.loot-pop{animation:lootPop .65s cubic-bezier(.2,.8,.2,1)}@keyframes lootPop{0%{transform:scale(.5) rotate(-8deg);opacity:0}70%{transform:scale(1.12) rotate(3deg);opacity:1}100%{transform:scale(1);opacity:1}}.mobileControls button{touch-action:none;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}#replayBtn{background:#44c9ff!important;color:#062b42!important;margin-left:8px}</style><style id="mobile-control-fix">
.pad button,.fire{touch-action:none;pointer-events:auto;-webkit-tap-highlight-color:transparent}
.pad button:focus-visible,.fire:focus-visible{outline:3px solid #fff;outline-offset:2px}
.mobileControls{position:relative;z-index:5}
</style><style id="rarity-gadget-styles">.rarity-label{padding:4px 8px;border-radius:9px;background:#101b2d;border:1px solid currentColor;display:inline-block}.card button{touch-action:manipulation;min-height:40px}.card .small{overflow-wrap:anywhere}#gadgetBtn:disabled{opacity:.55;filter:grayscale(.5)}.prime-tag{display:inline-block;margin-top:6px;padding:5px 9px;border-radius:9px;color:#fff;background:linear-gradient(110deg,#9148ff,#ee4fd6,#ffb62f);font-weight:1000;box-shadow:0 0 14px #d55cff88;animation:primeGlow 1.2s ease-in-out infinite alternate}@keyframes primeGlow{to{filter:brightness(1.3);transform:scale(1.03)}}</style></head><body>
<header class="top"><div class="logo">⭐ BRAVO ARENA</div><div class="currency">🪙 <span id="coins">0</span></div></header>
<main>
<section id="home" class="screen active"><div class="home"><div class="tag">ОДИНОЧНОЕ СТОЛКНОВЕНИЕ</div><div class="hero">🤖</div><div class="heroName">РИКО</div><p class="subtitle">Твой первый боец · Побеждай, собирай кубки и усиливай бойцов!</p><div class="pill" style="margin-top:8px">🏆 Кубки: <b id="totalTrophiesHome">0</b></div><button class="play" id="playHome">▶ ИГРАТЬ</button><div class="menuButtons"><button data-go="fighters">🥊 Бойцы</button><button data-go="trophies">🏆 Кубки и награды</button><button data-go="share">🔗 Поделиться</button></div></div></section>
<section id="fighters" class="screen panel"><button class="back" data-go="home">← Назад</button><h2>🥊 Бойцы</h2><p class="small">У каждого бойца свои кубки и титул. За 1000 кубков на бойце открывается ПРАЙМ. Монеты можно потратить на случайную награду, но новый боец выпадает не каждый раз.</p><div class="card" style="margin-bottom:12px"><b>🎁 Случайная награда · 250 🪙</b><p class="small">Шанс нового бойца — 25%. Иначе выпадут очки силы или монеты.</p><button id="buyReward" class="goldBtn">ПОЛУЧИТЬ НАГРАДУ</button><div id="lootResult" class="reward"></div></div><div id="fighterCards" class="cards"></div></section>
<section id="trophies" class="screen panel"><button class="back" data-go="home">← Назад</button><h2>🏆 Кубки и награды</h2><p class="small">Кубки начисляются выбранному бойцу. Чем больше кубков у тебя всего, тем больше наград и режимов открывается.</p><div class="card"><div style="font-size:42px">🏆</div><b>Всего кубков: <span id="totalTrophies">0</span></b><p class="small" id="nextReward">Следующая награда: 10 кубков</p></div><div id="trophyRewards" class="cards" style="margin-top:12px"></div><div id="reward" class="reward"></div></section>
<section id="share" class="screen panel"><button class="back" data-go="home">← Назад</button><h2>🔗 Поделиться игрой</h2><p class="small">Когда сайт будет опубликован на хостинге, нажми «Скопировать ссылку» и отправь её друзьям.</p><p class="share" id="urlBox"></p><button id="copyLink" class="goldBtn">СКОПИРОВАТЬ ССЫЛКУ</button><p class="small">Если ты открыл локальный файл, эта ссылка будет работать только на твоём устройстве. Для игры у друзей нужна публикация сайта в интернете.</p></section>
<section id="battle" class="screen"><div class="hud"><span class="pill" id="status">Одиночное столкновение</span><span class="pill" id="alive">🥊 6 бойцов</span><span class="pill" id="hp">❤️ 100</span><span class="pill" id="battleTrophies">🏆 0</span><button class="pill" id="quit" style="color:white">✕ Меню</button></div><div class="arena"><canvas id="game" width="800" height="690"></canvas><div class="overlay" id="overlay"><div><h2 id="modeTitle">Одиночное столкновение</h2><p id="modeDescription">Победи ботов, получи монеты и кубки!</p><label for="modeSelect">Режим:</label><br><select id="modeSelect" style="padding:10px;border-radius:10px;margin:8px;background:#fff"><option value="solo">Одиночное столкновение</option><option value="gems" id="gemsOption" disabled>💎 Захват кристаллов — откроется на 20 кубках</option></select><br><button id="startBattle">НАЧАТЬ БОЙ</button></div></div></div><div class="mobileControls"><div class="pad"><button class="blank"></button><button data-dir="up">▲</button><button class="blank"></button><button data-dir="left">◀</button><button data-dir="down">▼</button><button data-dir="right">▶</button></div><button class="fire" id="fire">ОГОНЬ</button></div><button id="gadgetBtn" class="goldBtn" style="margin:0 auto 8px;touch-action:manipulation">🧰 ИСПОЛЬЗОВАТЬ ГАДЖЕТ</button><p class="small">Телефон: удерживай стрелку направления, чтобы идти, и удерживай «ОГОНЬ», чтобы стрелять. Компьютер: WASD/стрелки — движение, пробел — атака. Режим «Захват кристаллов» открывается на 20 кубках.</p></section>
</main>
<script>
const fighters=[
{name:'Рико',emoji:'🤖',color:'#43c5ff',hp:100,speed:2.9,damage:17,range:190,desc:'Начальный боец',rarity:'Начальный',rarityColor:'#c7d3e5',gadget:'Рикошет',gadgetDesc:'Следующий выстрел рикошетит по двум врагам',passive:'Точная настройка',passiveDesc:'+8% к урону',passiveCost:450},
{name:'Бум',emoji:'💣',color:'#ff934a',hp:125,speed:2.45,damage:24,range:145,desc:'Сильный урон',rarity:'Редкий',rarityColor:'#45d66b',gadget:'Большой бум',gadgetDesc:'Наносит 28 урона рядом стоящим врагам',passive:'Крепкая броня',passiveDesc:'+12 к здоровью',passiveCost:500},
{name:'Луна',emoji:'🌙',color:'#bd8cff',hp:90,speed:3.35,damage:14,range:175,desc:'Очень быстрая',rarity:'Сверхредкий',rarityColor:'#55c9ff',gadget:'Лунный рывок',gadgetDesc:'Восстанавливает 25 здоровья',passive:'Лёгкие шаги',passiveDesc:'+8% скорости',passiveCost:550},
{name:'Танк',emoji:'🦾',color:'#ff5f70',hp:165,speed:2.05,damage:21,range:125,desc:'Много здоровья',rarity:'Эпический',rarityColor:'#c56bff',gadget:'Стальной щит',gadgetDesc:'Восстанавливает 40 здоровья',passive:'Тяжёлый корпус',passiveDesc:'+20 к здоровью',passiveCost:600},
{name:'Спарк',emoji:'⚡',color:'#ffe05b',hp:105,speed:2.8,damage:15,range:230,desc:'Дальняя атака',rarity:'Мифический',rarityColor:'#ff7e42',gadget:'Перегрузка',gadgetDesc:'Следующие 3 выстрела усилены',passive:'Заряженный луч',passiveDesc:'+10% к урону',passiveCost:650},
{name:'Мороз',emoji:'❄️',color:'#8cecff',hp:115,speed:2.55,damage:18,range:200,desc:'Замедляет врагов',rarity:'Редкий',rarityColor:'#45d66b',gadget:'Ледяная волна',gadgetDesc:'Наносит 18 урона всем рядом',passive:'Холодная выдержка',passiveDesc:'+15 к здоровью',passiveCost:500},
{name:'Тень',emoji:'🥷',color:'#9c9bb8',hp:95,speed:3.2,damage:20,range:150,desc:'Быстрый ближний бой',rarity:'Сверхредкий',rarityColor:'#55c9ff',gadget:'Исчезновение',gadgetDesc:'Восстанавливает 30 здоровья',passive:'Тихий шаг',passiveDesc:'+10% скорости',passiveCost:550},
{name:'Пиксель',emoji:'👾',color:'#6cf0a5',hp:110,speed:2.8,damage:16,range:215,desc:'Точный стрелок',rarity:'Редкий',rarityColor:'#45d66b',gadget:'Пиксельный залп',gadgetDesc:'Наносит 22 урона ближайшему врагу',passive:'Критический код',passiveDesc:'+9% к урону',passiveCost:500},
{name:'Вулкан',emoji:'🌋',color:'#ff6848',hp:145,speed:2.25,damage:22,range:160,desc:'Мощные взрывы',rarity:'Эпический',rarityColor:'#c56bff',gadget:'Лава',gadgetDesc:'Наносит 35 урона ближайшему врагу',passive:'Магма внутри',passiveDesc:'+18 к здоровью',passiveCost:600},
{name:'Дрифт',emoji:'🏎️',color:'#ffdf67',hp:100,speed:3.5,damage:15,range:165,desc:'Самый быстрый',rarity:'Сверхредкий',rarityColor:'#55c9ff',gadget:'Турбо',gadgetDesc:'Восстанавливает 25 здоровья',passive:'Турбодвигатель',passiveDesc:'+12% скорости',passiveCost:550},
{name:'Шторм',emoji:'🌩️',color:'#a7b8ff',hp:120,speed:2.7,damage:23,range:205,desc:'Громовой выстрел',rarity:'Мифический',rarityColor:'#ff7e42',gadget:'Громовой удар',gadgetDesc:'Наносит 30 урона ближайшему врагу',passive:'Грозовая сила',passiveDesc:'+10% к урону',passiveCost:650},
{name:'Фантом',emoji:'👻',color:'#d8e2ff',hp:105,speed:3.0,damage:19,range:190,desc:'Неуловимый боец',rarity:'Эпический',rarityColor:'#c56bff',gadget:'Призрачный импульс',gadgetDesc:'Восстанавливает 35 здоровья',passive:'Эфирная броня',passiveDesc:'+15 к здоровью',passiveCost:600},
{name:'Дракон',emoji:'🐉',color:'#68e58b',hp:155,speed:2.4,damage:25,range:180,desc:'Сильный и выносливый',rarity:'Легендарный',rarityColor:'#ffcf42',gadget:'Драконий огонь',gadgetDesc:'Наносит 40 урона ближайшему врагу',passive:'Драконья кровь',passiveDesc:'+22 к здоровью',passiveCost:750},
{name:'Космос',emoji:'🪐',color:'#d2a4ff',hp:120,speed:2.75,damage:24,range:240,desc:'Космическая дальность',rarity:'Легендарный',rarityColor:'#ffcf42',gadget:'Сверхновая',gadgetDesc:'Наносит 35 урона ближайшему врагу',passive:'Звёздный заряд',passiveDesc:'+12% к урону',passiveCost:750},
{name:'Король',emoji:'👑',color:'#ffd34d',hp:175,speed:2.35,damage:26,range:175,desc:'Король арены',rarity:'Легендарный',rarityColor:'#ffcf42',gadget:'Королевский приказ',gadgetDesc:'Восстанавливает 45 здоровья',passive:'Королевская броня',passiveDesc:'+25 к здоровью',passiveCost:800}
];
const $=id=>document.getElementById(id),canvas=$('game'),ctx=canvas.getContext('2d');let owned=[0],coins=0,player=null,bots=[],bullets=[],crates=[],gems=[],running=false,keys={},aim={x:1,y:0},last=0,moveTouch={},fireHeld=false,mode='solo',totalTrophies=0,selectedFighter=0,progress={},powerPoints={},claimedRewards=[],passives={},gadgetUsed=false,boostShots=0;
try{const save=JSON.parse(localStorage.getItem('bravoArenaSave')||'{}');owned=save.owned||owned;coins=save.coins||0;totalTrophies=save.totalTrophies||0;progress=save.progress||{};powerPoints=save.powerPoints||{};claimedRewards=save.claimedRewards||[];passives=save.passives||{}}catch(e){}
function saveGame(){try{localStorage.setItem('bravoArenaSave',JSON.stringify({owned,coins,totalTrophies,progress,powerPoints,claimedRewards,passives}))}catch(e){}}
const fighterTitles=['Рикошетный мастер','Король взрывов','Лунный охотник','Несокрушимый','Повелитель молний','Ледяной страж','Тень ночи','Мастер пикселей','Владыка лавы','Король дрифта','Громовержец','Призрачный чемпион','Драконья легенда','Повелитель космоса','Король арены'];
function trophies(i=selectedFighter){return progress[i]||0}function power(i=selectedFighter){return powerPoints[i]||0}function totalFighterTrophies(){return Object.values(progress).reduce((a,b)=>a+b,0)}
function primeUnlocked(i){return trophies(i)>=1000}
function go(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));$(id).classList.add('active');if(id==='share')$('urlBox').textContent=location.href;if(id==='fighters')renderFighters();if(id==='trophies')renderTrophies()}
document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>go(b.dataset.go));$('playHome').onclick=()=>{go('battle');reset()};$('quit').onclick=()=>{running=false;go('home')};
function renderFighters(){let box=$('fighterCards');box.innerHTML='';fighters.forEach((f,i)=>{let unlocked=owned.includes(i),d=document.createElement('div');d.className='card '+(unlocked?'':'locked');let lv=1+Math.floor(power(i)/5);d.innerHTML=`<div class="emoji fighterIcon">${unlocked?f.emoji:'🔒'}</div><b>${unlocked?f.name:'???'}</b><div class="rarity-label" style="color:${f.rarityColor};font-weight:1000;margin:5px 0">${f.rarity}</div><div class="small">${unlocked?f.desc:'Откроется из награды'}</div><div class="pill trophy-card" style="margin-top:6px">🏆 ${trophies(i)} кубков</div><div class="fighter-title">🎖️ ${fighterTitles[i]}</div>${primeUnlocked(i)?'<div class="prime-tag">✨ ПРАЙМ · 1000 КУБКОВ</div>':''}<div class="pill" style="margin-top:5px">💪 Ур. ${lv} · ⚡ ${power(i)} очков силы</div>${unlocked?`<div class="small" style="margin-top:8px">🎮 Гаджет: <b>${f.gadget}</b><br>${f.gadgetDesc}</div><button class="goldBtn" data-select="${i}">${selectedFighter===i?'✓ Выбран':'ВЫБРАТЬ'}</button><button class="upgrade" data-upgrade="${i}">⬆️ Улучшить · ${upgradeCost(i)} 🪙</button><div class="small" style="margin-top:8px">⭐ Пассивка: <b>${f.passive}</b><br>${f.passiveDesc}</div><button class="upgrade" data-passive="${i}">${passives[i]?'✅ Пассивка куплена':'Купить пассивку · '+f.passiveCost+' 🪙'}</button>`:''}`;box.appendChild(d)});box.querySelectorAll('[data-select]').forEach(b=>b.onclick=()=>{selectedFighter=+b.dataset.select;renderFighters()});box.querySelectorAll('[data-upgrade]').forEach(b=>b.onclick=()=>upgrade(+b.dataset.upgrade));box.querySelectorAll('[data-passive]').forEach(b=>b.onclick=()=>buyPassive(+b.dataset.passive));$('coins').textContent=coins;$('totalTrophiesHome').textContent=totalFighterTrophies();}
function upgradeCost(i){return 60+Math.floor(power(i)/5)*45}
function upgrade(i){if(!owned.includes(i))return;let cost=upgradeCost(i);if(coins<cost){alert('Не хватает монет! Побеждай в боях, чтобы заработать.');return}coins-=cost;powerPoints[i]=(powerPoints[i]||0)+1;saveGame();$('coins').textContent=coins;renderFighters();toast(`💪 +1 очко силы бойцу ${fighters[i].name}!`)}
function buyPassive(i){if(!owned.includes(i))return;if(passives[i]){toast('Пассивка уже куплена!');return}let cost=fighters[i].passiveCost;if(coins<cost){toast('Не хватает монет: нужно '+cost+' 🪙');return}coins-=cost;passives[i]=true;saveGame();$('coins').textContent=coins;renderFighters();toast('⭐ Куплена пассивка: '+fighters[i].passive)}
function useGadget(){if(!running||gadgetUsed)return;if(!owned.includes(selectedFighter))return;gadgetUsed=true;$('gadgetBtn').disabled=true;$('gadgetBtn').textContent='🧰 Гаджет использован';const f=fighters[selectedFighter];if(/урон|взрыв|волна|огонь|удар|залп|сверхновая|импульс/.test(f.gadgetDesc)){let target=nearest(player,bots);if(target){target.hp-=f.damage*1.8;if(target.hp<=0){target.alive=false;if(mode==='gems')gems.push({x:target.x,y:target.y,r:9})}}else{player.hp=Math.min(player.maxHp,player.hp+25)}}else{player.hp=Math.min(player.maxHp,player.hp+(/45/.test(f.gadgetDesc)?45:/40/.test(f.gadgetDesc)?40:30))}toast('🧰 Гаджет: '+f.gadget+'!');updateHud()}

function toast(msg){let t=document.createElement('div');t.className='floatReward';t.textContent=msg;t.style.cssText='position:fixed;z-index:99;top:22%;left:50%;transform:translateX(-50%);background:#152a47;border:2px solid #ffcf42;border-radius:16px;padding:14px 20px;font-weight:1000;text-align:center;box-shadow:0 8px 25px #0008';document.body.appendChild(t);setTimeout(()=>t.remove(),1300)}
function renderTrophies(){let total=totalFighterTrophies();$('totalTrophies').textContent=total;$('totalTrophiesHome').textContent=total;$('nextReward').textContent=total<10?'Следующая награда: 10 кубков — 100 монет':total<20?'Следующая награда: 20 кубков — режим «Захват кристаллов»':total<50?'Следующая награда: 50 кубков — новый боец':'Ты прошёл первые рубежи! Новые награды скоро.';$('gemsOption').disabled=total<20;$('gemsOption').textContent=total<20?'💎 Захват кристаллов — откроется на 20 кубках':'💎 Захват кристаллов';let box=$('trophyRewards');box.innerHTML='';[{n:10,t:'🪙 100 монет',d:'Награда за 10 кубков'},{n:20,t:'💎 Захват кристаллов',d:'Новый игровой режим'},{n:50,t:'🥊 Новый боец',d:'Открой бойца на 50 кубках'}].forEach(r=>{let got=total>=r.n;let d=document.createElement('div');d.className='card';d.innerHTML=`<div class="emoji">${got?'✅':'🔒'}</div><b>${r.t}</b><div class="small">${r.d}</div><div class="pill">${total}/${r.n} 🏆</div>`;box.appendChild(d)});if(total>=10&&!claimedRewards.includes(10)){coins+=100;claimedRewards.push(10);toast('🪙 +100 монет за 10 кубков!')}if(total>=50&&!claimedRewards.includes(50)){let lock=fighters.map((f,i)=>i).find(i=>!owned.includes(i));if(lock!==undefined){owned.push(lock);claimedRewards.push(50);toast(`🎉 Открыт боец ${fighters[lock].name}!`)}}saveGame();$('coins').textContent=coins;}
function reset(){mode=$('modeSelect').value;if(mode==='gems'&&totalFighterTrophies()<20){mode='solo';$('modeSelect').value='solo'}let f=fighters[selectedFighter],pw=power(selectedFighter),lv=1+Math.floor(pw/5);player={x:400,y:345,r:17,hp:f.hp+pw*4+(passives[selectedFighter]&&/здоровью|броня|корпус|кровь/.test(f.passiveDesc)?20:0),maxHp:f.hp+pw*4+(passives[selectedFighter]&&/здоровью|броня|корпус|кровь/.test(f.passiveDesc)?20:0),speed:f.speed*(passives[selectedFighter]&&/скорости/.test(f.passiveDesc)?1.12:1),damage:(f.damage+pw*1.2)*(passives[selectedFighter]&&/урону/.test(f.passiveDesc)?1.1:1),range:f.range,color:f.color,emoji:f.emoji,name:f.name,alive:true,cd:0,gems:0};bots=[];bullets=[];crates=[];gems=[];for(let i=0;i<5;i++){let bi=(i+1)%fighters.length,bf=fighters[bi];bots.push({x:70+Math.random()*660,y:65+Math.random()*560,r:16,hp:80+Math.random()*50,maxHp:130,speed:1.25+Math.random()*.55,damage:10+Math.random()*6,range:155,color:bf.color,emoji:bf.emoji,name:bf.name,alive:true,cd:Math.random()*40,gems:0})}for(let i=0;i<9;i++)crates.push({x:65+Math.random()*670,y:60+Math.random()*570,r:13,hp:2});for(let i=0;i<(mode==='gems'?10:0);i++)gems.push({x:55+Math.random()*690,y:55+Math.random()*580,r:9});running=true;gadgetUsed=false;boostShots=0;$('gadgetBtn').textContent='🧰 '+f.gadget+' (1 раз за бой)';$('gadgetBtn').disabled=false;$('overlay').classList.add('hidden');$('status').textContent=mode==='gems'?'💎 Захват кристаллов':'Одиночное столкновение';updateHud()}
function updateHud(){$('alive').textContent=mode==='gems'?'💎 '+(player?.gems||0)+'/10':'🥊 '+(bots.filter(b=>b.alive).length+(player?.alive?1:0))+' бойцов';$('hp').textContent='❤️ '+Math.max(0,Math.ceil(player?.hp||0));$('battleTrophies').textContent='🏆 '+trophies()}
function shoot(a,tx,ty,isPlayer=false){if(a.cd>0)return;a.cd=isPlayer?14:45;let dx=tx-a.x,dy=ty-a.y,d=Math.hypot(dx,dy)||1;bullets.push({x:a.x,y:a.y,vx:dx/d*(isPlayer?7.2:4.4),vy:dy/d*(isPlayer?7.2:4.4),life:isPlayer?34:42,damage:a.damage,owner:a,color:a.color})}
function nearest(a,list){let best=null,bd=1e9;for(let b of list){if(!b.alive||b===a)continue;let d=Math.hypot(b.x-a.x,b.y-a.y);if(d<bd){bd=d;best=b}}return best}function clamp(a,min,max){return Math.max(min,Math.min(max,a))}
function finish(win){if(!running)return;running=false;let earnedCoins=win?(mode==='gems'?70:50):15;let earnedTrophies=win?(mode==='gems'?8:6):1;let earnedPower=win?3:1;coins+=earnedCoins;progress[selectedFighter]=(progress[selectedFighter]||0)+earnedTrophies;powerPoints[selectedFighter]=(powerPoints[selectedFighter]||0)+earnedPower;
let fighterDrop='';if(win&&Math.random()<0.18){let available=fighters.map((f,i)=>i).filter(i=>!owned.includes(i));if(available.length){let drop=available[Math.floor(Math.random()*available.length)];owned.push(drop);fighterDrop=`<div class="loot-pop" style="font-size:20px;margin-top:8px">🎉 Новый боец: ${fighters[drop].emoji} ${fighters[drop].name}!</div>`}}
saveGame();$('coins').textContent=coins;$('overlay').classList.remove('hidden');$('overlay').innerHTML=`<div><h2>${win?'🏆 ПОБЕДА!':'💥 ТЫ ВЫБЫЛ'}</h2><p>${win?'Отличный бой! Вот твои награды.':'За участие тоже есть награда!'}</p><div class="card loot-pop"><div style="font-size:36px"><span class="coinFly">🪙</span> <span class="coinFly">⚡</span> 🏆</div><b>+${earnedTrophies} кубков · +${earnedCoins} монет</b><div class="small">⚡ +${earnedPower} очка силы для ${fighters[selectedFighter].name}</div><div class="small">${fighters[selectedFighter].emoji} ${fighters[selectedFighter].name}: ${trophies()} кубков</div><div class="fighter-title">🎖️ ${fighterTitles[selectedFighter]}</div>${primeUnlocked(selectedFighter)?'<div class="prime-tag">✨ ПРАЙМ ОТКРЫТ!</div>':''}${fighterDrop}</div><div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:12px"><button id="resultBtn">ЗАБРАТЬ НАГРАДЫ</button><button id="replayBtn">🔁 ЕЩЁ РАЗ</button></div></div>`;$('resultBtn').addEventListener('click',()=>{renderTrophies();renderFighters();go('trophies')});$('replayBtn').addEventListener('click',()=>{keys={};moveTouch={};fireHeld=false;go('battle');reset()});$('status').textContent=win?'Победа!':'Бой окончен';toast(`🏆 +${earnedTrophies} · 🪙 +${earnedCoins} · ⚡ +${earnedPower}`)}
function tick(dt){if(!running)return;let p=player,dx=0,dy=0;if(keys.ArrowLeft||keys.a||keys.A||moveTouch.left)dx--;if(keys.ArrowRight||keys.d||keys.D||moveTouch.right)dx++;if(keys.ArrowUp||keys.w||keys.W||moveTouch.up)dy--;if(keys.ArrowDown||keys.s||keys.S||moveTouch.down)dy++;let mag=Math.hypot(dx,dy)||1;if(dx||dy){p.x+=dx/mag*p.speed*dt;p.y+=dy/mag*p.speed*dt;aim={x:dx/mag,y:dy/mag}}p.x=clamp(p.x,25,775);p.y=clamp(p.y,25,665);p.cd=Math.max(0,p.cd-dt);if((keys[' ']||fireHeld)&&p.cd<=0){let t=nearest(p,bots);shoot(p,t?t.x:p.x+aim.x*100,t?t.y:p.y+aim.y*100,true)}
for(let b of bots){if(!b.alive)continue;b.cd=Math.max(0,b.cd-dt);let t=nearest(b,[p,...bots]);if(!t)continue;let vx=t.x-b.x,vy=t.y-b.y,d=Math.hypot(vx,vy)||1;if(d>100){b.x+=vx/d*b.speed*dt;b.y+=vy/d*b.speed*dt}else{b.x-=vy/d*b.speed*.5*dt;b.y+=vx/d*b.speed*.5*dt}b.x=clamp(b.x,25,775);b.y=clamp(b.y,25,665);if(d<b.range&&b.cd<=0)shoot(b,t.x,t.y,false)}
for(let q of bullets){q.x+=q.vx*dt;q.y+=q.vy*dt;q.life-=dt;let targets=q.owner===p?bots.filter(b=>b.alive):[p,...bots].filter(b=>b.alive&&b!==q.owner);for(let t of targets){if(Math.hypot(t.x-q.x,t.y-q.y)<t.r+4){t.hp-=q.damage;q.life=0;if(t.hp<=0){t.alive=false;if(t===p)finish(false);else if(q.owner===p){p.hp=Math.min(p.maxHp,p.hp+8);if(mode==='gems')gems.push({x:t.x,y:t.y,r:9})}}break}}}bullets=bullets.filter(q=>q.life>0&&q.x>0&&q.x<800&&q.y>0&&q.y<690);for(let c of crates){if(c.hp&&Math.hypot(p.x-c.x,p.y-c.y)<p.r+c.r){c.hp=0;p.hp=Math.min(p.maxHp,p.hp+18)}}for(let g of gems){if(!g.taken&&Math.hypot(p.x-g.x,p.y-g.y)<p.r+g.r){g.taken=true;p.gems=(p.gems||0)+1;toast('💎 +1 кристалл!')}}gems=gems.filter(g=>!g.taken);if(p.alive&&((mode==='gems'&&(p.gems||0)>=10)|| (mode==='solo'&&bots.every(b=>!b.alive))))finish(true);updateHud()}
function draw(){ctx.clearRect(0,0,800,690);ctx.fillStyle='#8cbd5f';ctx.fillRect(0,0,800,690);ctx.strokeStyle='#6ea34b';ctx.lineWidth=1;for(let x=0;x<800;x+=40)for(let y=0;y<690;y+=40)ctx.strokeRect(x,y,40,40);for(let i=0;i<14;i++){let x=(i*137+30)%780,y=(i*197+40)%660;ctx.fillStyle='#4e8744';ctx.beginPath();ctx.arc(x,y,15,0,7);ctx.fill();ctx.fillStyle='#34723b';ctx.fillRect(x-4,y+8,8,12)}for(let c of crates){if(!c.hp)continue;ctx.fillStyle='#d69b45';ctx.fillRect(c.x-12,c.y-12,24,24);ctx.strokeStyle='#ffe09a';ctx.lineWidth=3;ctx.strokeRect(c.x-9,c.y-9,18,18)}for(let g of gems){ctx.save();ctx.translate(g.x,g.y);ctx.rotate(Math.PI/4);ctx.fillStyle='#68f3ff';ctx.fillRect(-7,-7,14,14);ctx.strokeStyle='#e4ffff';ctx.lineWidth=2;ctx.strokeRect(-7,-7,14,14);ctx.restore()}for(let q of bullets){ctx.fillStyle=q.color;ctx.beginPath();ctx.arc(q.x,q.y,5,0,7);ctx.fill()}for(let b of [...bots,...(player?[player]:[])]){if(!b.alive)continue;ctx.fillStyle='#0003';ctx.beginPath();ctx.ellipse(b.x,b.y+13,17,7,0,0,7);ctx.fill();ctx.fillStyle=b.color;ctx.beginPath();ctx.arc(b.x,b.y,b.r,0,7);ctx.fill();ctx.strokeStyle=b===player?'#fff':'#27334a';ctx.lineWidth=b===player?4:2;ctx.stroke();ctx.font='19px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(b.emoji,b.x,b.y);ctx.fillStyle='#572b2b';ctx.fillRect(b.x-18,b.y-27,36,5);ctx.fillStyle='#54e66d';ctx.fillRect(b.x-18,b.y-27,36*clamp(b.hp/(b.maxHp||100),0,1),5)}requestAnimationFrame(draw)}
function loop(t){let dt=Math.min((t-last)/16.67||1,2);last=t;tick(dt);requestAnimationFrame(loop)}
window.addEventListener('keydown',e=>{keys[e.key]=true;if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key))e.preventDefault()});window.addEventListener('keyup',e=>keys[e.key]=false);
canvas.addEventListener('pointerdown',e=>{if(!running)return;let r=canvas.getBoundingClientRect(),x=(e.clientX-r.left)*800/r.width,y=(e.clientY-r.top)*690/r.height;aim={x:x-player.x,y:y-player.y};let d=Math.hypot(aim.x,aim.y)||1;aim.x/=d;aim.y/=d;shoot(player,x,y,true)});
// Robust mobile controls: set direction on press and release only when the pointer/touch ends.
document.querySelectorAll('[data-dir]').forEach(b=>{
  const d=b.dataset.dir;
  b.addEventListener('pointerdown',e=>{e.preventDefault();moveTouch[d]=true;try{b.setPointerCapture(e.pointerId)}catch(_){}});
  b.addEventListener('touchstart',e=>{e.preventDefault();moveTouch[d]=true},{passive:false});
  b.addEventListener('contextmenu',e=>e.preventDefault());
});
window.addEventListener('pointerup',()=>{moveTouch={};fireHeld=false});
window.addEventListener('pointercancel',()=>{moveTouch={};fireHeld=false});
window.addEventListener('touchend',()=>{moveTouch={};fireHeld=false},{passive:true});
window.addEventListener('touchcancel',()=>{moveTouch={};fireHeld=false},{passive:true});
$('fire').addEventListener('pointerdown',e=>{e.preventDefault();fireHeld=true});
$('fire').addEventListener('touchstart',e=>{e.preventDefault();fireHeld=true},{passive:false});
$('fire').addEventListener('contextmenu',e=>e.preventDefault());
$('buyReward').onclick=()=>{if(coins<250){$('lootResult').textContent='Не хватает монет: нужно 250 🪙';return}coins-=250;$('coins').textContent=coins;let roll=Math.random(),available=fighters.map((f,i)=>i).filter(i=>!owned.includes(i)),msg='';if(roll<0.25&&available.length){let i=available[Math.floor(Math.random()*available.length)];owned.push(i);msg=`🎉 ${fighters[i].emoji} ${fighters[i].name} присоединился к тебе!`}else if(roll<0.75){let i=owned[Math.floor(Math.random()*owned.length)];powerPoints[i]=(powerPoints[i]||0)+5;msg=`⚡ +5 очков силы для ${fighters[i].name}!`}else{coins+=150;msg='🪙 Компенсация: +150 монет'}saveGame();$('coins').textContent=coins;$('lootResult').innerHTML=`<div class="loot-pop" style="font-size:19px">${msg}</div>`;renderFighters();toast(msg)};
document.addEventListener('click',function(e){
  const b=e.target.closest('#resultBtn,#replayBtn');
  if(!b)return;
  if(b.id==='resultBtn'){renderTrophies();renderFighters();go('trophies');}
  if(b.id==='replayBtn'){keys={};moveTouch={};fireHeld=false;go('battle');reset();}
});

$('gadgetBtn').onclick=useGadget;$('startBattle').onclick=reset;$('copyLink').onclick=async()=>{let url=location.href;try{await navigator.clipboard.writeText(url);$('copyLink').textContent='✅ Ссылка скопирована'}catch(e){$('urlBox').textContent=url+' — выдели и скопируй вручную'}};$('urlBox').textContent=location.href;$('coins').textContent=coins;renderFighters();renderTrophies();draw();requestAnimationFrame(loop);
</script></body></html>
